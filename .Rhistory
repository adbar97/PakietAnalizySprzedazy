usethis::use_r("functions")
devtools::document()
devtools::install()
knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE)
# Załadowanie wymaganego pakietu
library(PakietAnalizySprzedazy)
library(ggplot2)
library(dplyr)
library(knitr)
# Generowanie prognoz na 30 dni w przód
forecasts <- create_prognosis(df_clean, periods = 30)
# Wczytanie danych (należy upewnić się, że pliki csv są w tym samym folderze co skrypt)
df_raw <- load_sales_data(
train_path = "train.csv",
stores_path = "stores.csv",
holidays_path = "holidays_events.csv"
)
# Wczytanie danych (należy upewnić się, że pliki csv są w tym samym folderze co skrypt)
df_raw <- load_sales_data(
train_path = "train.csv",
stores_path = "stores.csv",
holidays_path = "holidays_events.csv"
)
# Szybka walidacja jakości
validate_sales_ts(df_raw)
# Czyszczenie i przygotowanie danych (agregacja dzienna)
df_clean \<- clean_sales_ts(df_raw, agg_level = "day")
df_clean <- clean_sales_ts(df_raw, agg_level = "day")
summary \<- create_management_summary(df_clean)
summary <- create_management_summary(df_clean)
# Wyświetlenie wyników w estetycznej formie
kable(data.frame(
"Metryka" = c("Najlepszy Sklep (ID)", "Najgorszy Sklep (ID)", "Najlepsza Kategoria"),
"Wartość" = c(summary$Best_Store, summary$Worst_Store, summary\$Top_Category)
summary <- create_management_summary(df_clean)
# Wyświetlenie wyników w estetycznej formie
kable(data.frame(
"Metryka" = c("Najlepszy Sklep (ID)", "Najgorszy Sklep (ID)", "Najlepsza Kategoria"),
"Wartość" = c(summary$Best_Store, summary$Worst_Store, summary$Top_Category)
))
metrics \<- compute_sales_metrics(df_clean)
metrics <- compute_sales_metrics(df_clean)
plot_sales_trends(metrics)
ggplot(metrics, aes(x = promo_share, y = total_sales)) +
geom_point(alpha = 0.5, color = "steelblue") +
geom_smooth(method = "lm", color = "red") +
labs(
title = "Wpływ udziału promocji na całkowitą sprzedaż",
x = "Udział Promocji (Promo Share)",
y = "Całkowita Sprzedaż"
) +
theme_minimal()
# Generowanie prognoz na 30 dni w przód
forecasts <- create_prognosis(df_clean, periods = 30)
# Wizualizacja prognozy ARIMA
plot(forecasts$ARIMA, main = "30-dniowa Prognoza Sprzedaży (Model ARIMA)",
ylab = "Sprzedaż", xlab = "Czas (tygodnie)")
# Analiza dla miasta Quito
quito_analysis <- sales_ts_logic(df_clean, p_city = "Quito")
# Wykres trendów specjalnie dla Quito
quito_analysis$plot + labs(title = "Trendy Sprzedażowe - Miasto: Quito")
# Generowanie prognoz na 30 dni w przód
forecasts <- create_prognosis(df_clean, periods = 30)
# Wizualizacja prognozy ARIMA
plot(forecasts$ARIMA, main = "30-dniowa Prognoza Sprzedaży (Model ARIMA)",
ylab = "Sprzedaż", xlab = "Czas (tygodnie)")
